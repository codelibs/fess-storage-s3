<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>fess-storage-s3</artifactId>
	<packaging>jar</packaging>
	<name>S3 Storage Plugin</name>
	<version>15.9.0-SNAPSHOT</version>
	<description>Amazon S3 and S3-compatible storage support for Fess: the storage client behind storage.type=s3 and the crawler client behind s3: URLs.</description>
	<scm>
		<connection>scm:git:git@github.com:codelibs/fess-storage-s3.git</connection>
		<developerConnection>scm:git:git@github.com:codelibs/fess-storage-s3.git</developerConnection>
		<url>https://github.com/codelibs/fess-storage-s3</url>
		<tag>HEAD</tag>
	</scm>
	<parent>
		<groupId>org.codelibs.fess</groupId>
		<artifactId>fess-parent</artifactId>
		<version>15.9.0-SNAPSHOT</version>
		<relativePath />
	</parent>
	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<!-- Mounts this jar into the webapp class loader (FessWebResourceRoot). The
							     storage client is used from the admin UI, so the webapp has to see it; the
							     crawler, thumbnail, suggest and chunk processes get WEB-INF/plugin on their
							     class path regardless of this entry. -->
							<Fess-WebAppJar>true</Fess-WebAppJar>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<!-- No relocation. S3Client and the s3: URL handler live in fess-crawler,
							     outside this jar, and resolve software.amazon.awssdk by its real name.
							     Relocating would leave them with nothing to bind to. -->
							<artifactSet>
								<!-- What the war already carries. Declaring org.codelibs.fess:fess as provided
								     does not keep these four out on its own: when Fess and the SDK need the same
								     artifact, Maven keeps Fess's version but widens the scope to the widest of
								     the two, so the node arrives at compile or runtime instead of provided and
								     would be shaded.
								     Each entry below is an artifact the war still ships, in the httpcomponents
								     case at a different version: the war has httpclient5 5.6.1 and httpcore5 5.4,
								     while apache5-client asks for 5.6.4 and 5.4.3, and Fess's versions win here
								     too. WEB-INF/lib precedes WEB-INF/plugin on every class path Fess builds, so
								     a shaded copy of these would never be read: leaving them out keeps one
								     version of each class in the installation and the combined class path equal
								     to what the war had before the split.
								     Under-excluding wastes space; over-excluding fails at run time with
								     NoClassDefFoundError, so verify against `mvn dependency:list` on Fess before
								     adding an entry. slf4j-api and httpclient5 are direct dependencies of Fess
								     and reactive-streams arrives there with OpenSearch, so none of the three
								     leaves the war together with the SDK. -->
								<excludes>
									<exclude>org.apache.httpcomponents.client5:*</exclude>
									<exclude>org.apache.httpcomponents.core5:*</exclude>
									<exclude>org.reactivestreams:*</exclude>
									<exclude>org.slf4j:*</exclude>
								</excludes>
							</artifactSet>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-javadoc-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.mycila</groupId>
				<artifactId>license-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>net.revelc.code.formatter</groupId>
				<artifactId>formatter-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<!-- Fess plugins are distributed through maven.codelibs.org instead of Maven Central.
	     This cannot be inherited from fess-parent: distributionManagement is inherited
	     unconditionally, so declaring it there would also redirect the SNAPSHOT
	     deployments of fess-parent, fess, fess-crawler, fess-crawler-playwright and
	     fess-suggest, which stay on Maven Central. The scpexe transport comes from
	     the wagon-ssh-external build extension inherited from fess-parent. -->
	<distributionManagement>
		<repository>
			<id>codelibs-repo</id>
			<name>CodeLibs Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/release</url>
		</repository>
		<snapshotRepository>
			<id>codelibs-snapshots</id>
			<name>CodeLibs Snapshot Repository</name>
			<url>scpexe://maven.codelibs.org/var/www/maven/snapshot</url>
		</snapshotRepository>
	</distributionManagement>
	<repositories>
		<repository>
			<id>snapshots.central.sonatype.com</id>
			<url>https://central.sonatype.com/repository/maven-snapshots</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>
	<dependencies>
		<!-- Declared before s3 on purpose. Everything Fess ships arrives here as a provided
		     transitive dependency, and a provided node beats a compile node of the same artifact at
		     the same depth by declaration order, so the shade below picks up only what the war does
		     not already carry. -->
		<dependency>
			<groupId>org.codelibs.fess</groupId>
			<artifactId>fess</artifactId>
			<version>${fess.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<!-- CrawlerClientCreator and CrawlerContainer, for registering S3Client. S3Client
			     itself stays in fess-crawler, outside this jar, and is named only as a string
			     from crawler/client++.xml. -->
			<groupId>org.codelibs.fess</groupId>
			<artifactId>fess-crawler</artifactId>
			<version>${crawler.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>jakarta.annotation</groupId>
			<artifactId>jakarta.annotation-api</artifactId>
			<version>${jakarta.annotation.api.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>s3</artifactId>
			<version>${s3.version}</version>
			<exclusions>
				<!-- The asynchronous client is never built here, and netty-nio-client is ten jars
				     of Netty. Fess carried the same exclusion while the SDK lived in the war. -->
				<exclusion>
					<groupId>software.amazon.awssdk</groupId>
					<artifactId>netty-nio-client</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-api</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
